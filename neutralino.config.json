{
  "applicationId": "com.ficcif.dsh-plugin-manager",
  "version": "1.1.0",
  "defaultMode": "window",
  "port": 8766,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "singlePage": false,
  "nativeAllowList": ["app.*", "filesystem.*"],
  "modes": {
    "window": {
      "title": "DSH 插件管理器",
      "width": 1120,
      "height": 780,
      "minWidth": 820,
      "minHeight": 560,
      "center": true,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "filesystem": {
    "allowedPaths": [
      "C:/Users/Administrator/.dsh",
      "C:/Users/Administrator/deepseek-harness"
    ]
  },
  "cli": {
    "binaryName": "DSH插件管理器",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0"
  }
}
